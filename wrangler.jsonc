{
  "name": "code-project",
  "compatibility_date": "2024-09-25",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
    "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
